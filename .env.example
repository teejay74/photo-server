# Порт сайта на домашнем сервере
WEB_PORT=8080

# Каталог оригиналов на домашнем сервере
PHOTO_DIR=/srv/photos/xiaomi-13t/Camera

# Файл в корне фотохранилища, подтверждающий, что диск смонтирован
PHOTO_MARKER_FILE=.photodom-storage

# Данные для входа в галерею
PHOTO_USER=photos
PHOTO_PASSWORD=replace-with-a-long-random-password

# Срок сессии. Secure-cookie включайте только после настройки HTTPS
PHOTO_SESSION_DAYS=30
PHOTO_COOKIE_SECURE=false

# UID/GID пользователя, которому принадлежат фотографии на сервере.
# Узнать значения: id -u photos && id -g photos
APP_UID=1000
APP_GID=1000

# Период проверки новых файлов в секундах
PHOTO_SCAN_INTERVAL=300

# Умный каталог: локальный OCR и пауза между фотографиями для ограничения CPU
PHOTO_SMART_OCR=true
PHOTO_SMART_DELAY=1.5
PHOTO_SMART_OCR_LANGUAGES=rus+eng
PHOTO_SMART_OCR_TIMEOUT=20

# Автоматическая копия SQLite: интервал в часах и количество хранимых копий
PHOTO_BACKUP_INTERVAL=24
PHOTO_BACKUP_RETENTION=7
